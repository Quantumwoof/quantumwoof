# Wooftag minting (ISSUE ONLY — server never stores plaintext, never sends on Cardano)
# SHA-256(tag + WOOFTAG_PEPPER). Use a long random secret in Vercel Production/Preview.
WOOFTAG_PEPPER=

# Durable store (required in production). Either Upstash Redis REST:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# …or Vercel KV aliases (same REST protocol):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Local `bun run dev` without Redis uses an in-memory store (lost on restart).
# `next build` does not require these vars.

# --- Optional "Claim your Wooftag with X" (ship dark until ready) ---
# Flag must be on/1/true AND all three secrets below set, or claim stays off.
WOOFTAG_X_CLAIM=
X_CLIENT_ID=
X_CLIENT_SECRET=
# HMAC session cookies + AES key material for encrypted tip re-show (min 16 chars).
QW_SESSION_SECRET=
# Public site origin for OAuth callback allowlist (e.g. https://www.quantumwoof.io)
SITE_URL=https://www.quantumwoof.io
# Local tests only — override X API host (ignored when NODE_ENV=production)
# X_API_BASE=http://127.0.0.1:9
